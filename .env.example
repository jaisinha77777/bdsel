# Copy to .env and fill in. Never commit the real .env.

# Slack- or Discord-compatible incoming webhook for the daily uptime summary.
MONITOR_WEBHOOK_URL=

# Contact shown in the User-Agent so store owners can reach us about our crawler.
TOOLKIT_CONTACT=devops@example.com

# Minimum delay between two requests to the same host, in milliseconds.
REQUEST_INTERVAL_MS=1000

# Per-request timeout in milliseconds.
REQUEST_TIMEOUT_MS=15000

# Port for the product-endpoints API.
PORT=3000

# Cache TTL for the product-endpoints API, in milliseconds (default 5 minutes).
CACHE_TTL_MS=300000
